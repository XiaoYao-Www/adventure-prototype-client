; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Adventure Prototype"
config/version="0.3.1"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/handheld/orientation=4

window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[game]

content_dir=""
version_code=5
update_enabled=true
update_manifest_url="https://github.com/XiaoYao-Www/adventure-prototype-client/releases/latest/download/latest.json"
data_manifest_url="https://github.com/XiaoYao-Www/adventure-prototype-data/releases/latest/download/latest_data.json"

